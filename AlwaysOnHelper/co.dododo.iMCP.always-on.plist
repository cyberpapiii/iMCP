<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>co.dododo.iMCP.always-on.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/iMCPAlwaysOn</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>co.dododo.iMCP</string>
	</array>
    <key>KeepAlive</key>
    <true/>
	<!-- Standard, not Background. A Background job is throttled under boot
	     contention: measured on a cold boot this helper was exec'd at 01:10:18
	     and did not reach its first launch request until 01:11:11, so the app
	     users expect at login took 53 extra seconds to appear. The helper does
	     one thing, immediately, and then sleeps on a process source. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>LimitLoadToSessionType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<true/>
    <key>ThrottleInterval</key>
    <integer>1</integer>
</dict>
</plist>
